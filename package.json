{
  "name": "fitnesscoach",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:live": "RUN_LIVE_WORKOUT_TEST=1 node --env-file=.env.local ./node_modules/vitest/vitest.mjs run tests/live-generation.test.ts --disableConsoleIntercept",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "idb": "^8.0.4",
    "preact": "^10.29.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "jsdom": "^27.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
